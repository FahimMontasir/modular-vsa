{
  "name": "@modular-vsa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./doc": "./src/README.md"
  },
  "scripts": {
    "build": "vp pack",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --env-file=.env.local run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "dkr:start": "docker compose --env-file .env.local up -d --wait",
    "dkr:stop": "docker compose --env-file .env.local stop",
    "dkr:down": "docker compose --env-file .env.local down"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysia/server-timing": "^1.4.1",
    "@elysiajs/cors": "^1.4.2",
    "@modular-vsa/auth": "workspace:*",
    "@modular-vsa/db": "workspace:*",
    "@modular-vsa/env": "workspace:*",
    "@modular-vsa/home": "workspace:*",
    "@modular-vsa/jobs": "workspace:*",
    "@modular-vsa/notification": "workspace:*",
    "@modular-vsa/shared": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@modular-vsa/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
