{
  "name": "@modular-vsa/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../apps/server/.env.local run scripts/studio.ts",
    "db:push": "bun --bun --env-file=../../apps/server/.env.local drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "bun --bun --env-file=../../apps/server/.env.local drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "bun --env-file=../../apps/server/.env.local run scripts/studio.ts",
    "db:migrate": "bun --bun --env-file=../../apps/server/.env.local drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@modular-vsa/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@modular-vsa/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8"
  }
}
