{
  "name": "modular-vsa",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@babel/core": "^7.29.0",
      "babel-plugin-react-compiler": "1.0.0",
      "@lingui/babel-plugin-lingui-macro": "6.0.1",
      "@lingui/cli": "6.0.1",
      "@lingui/conf": "6.0.1",
      "@lingui/core": "6.0.1",
      "@lingui/format-po": "6.0.1",
      "@lingui/react": "6.0.1",
      "@lingui/vite-plugin": "6.0.1",
      "@rolldown/plugin-babel": "0.2.3",
      "typescript": "6",
      "@types/bun": "^1.3.14",
      "better-auth": "1.6.11",
      "@tanstack/react-form": "1.33.2",
      "@tanstack/react-pacer": "0.22.1",
      "@types/react-dom": "19.2.3",
      "@sinclair/typebox": "0.34.49",
      "@elysiajs/eden": "1.4.9",
      "elysia": "1.4.28",
      "drizzle-typebox": "0.3.3",
      "drizzle-orm": "0.45.2",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "@types/react": "19.2.14",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
      "tailwindcss": "4.3.0",
      "@tanstack/react-query": "5.100.10",
      "@tanstack/react-table": "8.21.3",
      "@tanstack/react-virtual": "3.14.9",
      "@tanstack/devtools-vite": "0.7.0",
      "@tanstack/react-devtools": "0.10.5",
      "@tanstack/react-form-devtools": "0.2.27",
      "@tanstack/react-query-devtools": "5.100.10",
      "@tanstack/react-router-devtools": "1.167.0",
      "@types/node": "25.8.0",
      "vite-plus": "0.2.4"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "git config --local core.hooksPath .github/hooks",
    "dev": "bun run dkr:start && bun run db:push && bun run dev:workspace",
    "dev:workspace": "vp run --parallel --no-cache -F @modular-vsa/portal -F @modular-vsa/server -F @modular-vsa/db dev",
    "build": "vp run -r --cache build",
    "check": "vp check --fix",
    "check:perf": "bunx --bun react-doctor@latest",
    "test:unit": "vp run -F '@modular-vsa/*' --no-cache test:unit",
    "test:integration": "bun run dkr:start && bun run db:push && vp run -F '@modular-vsa/*' --no-cache test:integration",
    "test:e2e": "npm --prefix tests test",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "db:push": "bun -F @modular-vsa/db db:push",
    "db:studio": "bun -F @modular-vsa/db db:studio",
    "db:generate": "bun -F @modular-vsa/db db:generate",
    "db:migrate": "bun -F @modular-vsa/db db:migrate",
    "dkr:start": "vp run --no-cache @modular-vsa/server#dkr:start",
    "dkr:stop": "vp run --no-cache @modular-vsa/server#dkr:stop",
    "dkr:down": "vp run --no-cache @modular-vsa/server#dkr:down",
    "update:deps": "bun update --interactive --recursive",
    "add:ui": "cd packages/_ui && bunx --bun shadcn@latest add",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name '*.tsbuildinfo' -type f -delete",
    "doctor": "bun scripts/react-doctor.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "catalog:",
    "@modular-vsa/env": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "@tanstack/react-query": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-typebox": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@modular-vsa/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-doctor": "^0.2.14",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
